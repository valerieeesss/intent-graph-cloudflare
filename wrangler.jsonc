{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "intent-graph-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2026-11-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "GOOGLE_CLOUD_PROJECT": "entity-detector-510013",
    "GOOGLE_CLOUD_LOCATION": "us-central1",
    "VERTEX_EMBEDDING_MODEL": "gemini-embedding-001",
    "ANTHROPIC_MODEL": "claude-sonnet-4-6"
  },
  "secrets": {
    "required": ["GOOGLE_SERVICE_ACCOUNT_JSON"]
  },
"observability": {
    "logs": {
      "enabled": false,
      "invocation_logs": true
    }
  }
}
